	static void add(HashMap<Integer,Integer> A, int key){
		A.put(key,A.getOrDefault(key,0)+1);
	}
	static void remove(HashMap<Integer,Integer>A, int key){
		if(!A.containsKey(key))return;
		A.put(key,A.get(key)-1);
		if(A.get(key)==0){
			A.remove(key);
		}
	}
	static long ctl[];
