        int t=1;
        outer: while(t-->0) {
            int n=sc.nextInt();
            int d=sc.nextInt();
            HashSet<Long>hs=new HashSet<>();
            long a[]=new long[n];
            for(int i=0;i<n;i++) {
                a[i]=sc.nextLong();
            }
            hs.add(a[0]-d);
            hs.add(a[n-1]+d);
            for(int i=0;i<n-1;i++) {
                long forward = a[i] + d;
                if(forward <= a[i+1] - d) {
                    hs.add(forward);
                }
            }
            for(int i=n-1;i>0;i--) {
                long backward = a[i] - d;
                if(backward >= a[i-1] + d) {
                    hs.add(backward);
                }
            }
            out.println(hs.size());
        }
        out.println();
